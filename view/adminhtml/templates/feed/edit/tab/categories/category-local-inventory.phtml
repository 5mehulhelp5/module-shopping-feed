<?php

/* @var $block \MageOS\ShoppingFeed\Block\Adminhtml\Feed\Edit\Tab\Categories\CategoryTaxonomy */
$element = $block->getElement();
$inactiveTitle = __('Category not active for this store.');
$taxonomyPlaceholder = __('Type at least 3 characters');
?>
<?php $htmlId      = $block->getElement()->getHtmlId() ?>
<?php $htmlClass   = $block->getElement()->getClass() ?>
<?php $htmlName    = $block->getElement()->getName() ?>
<?php $readonly    = $block->getElement()->getReadonly() || $block->getElement()->getDisabled() ?>

<script>
    taxonomy = {};
</script>

<div class="field" id="attribute-<?= $escaper->escapeHtml($htmlId) ?>-container"
     data-attribute-code="<?= $escaper->escapeHtml($htmlId) ?>"
     data-apply-to="<?= $escaper->escapeHtml(
         $this->helper(\Magento\Framework\Json\Helper\Data::class)->jsonEncode(
             $element->hasEntityAttribute() ? $element->getEntityAttribute()->getApplyTo() : []
         )
     )?>">
    <div>
        <ul>
<?php // phpcs:ignore Generic.Files.LineLength.TooLong -- translatable phrase ?>
            <li><?= $escaper->escapeHtml(__('Products can be included or excluded from feed by checking the right checkbox on a category row. <br />One enabled category is sufficient to include the a product in the feed which is assigned to multipe categories.'), ['br']) ?></li>
        </ul>
    </div>

    <div class="control">

        <div class="category_taxonomy_actions">
            <a href="#" id="taxonomy-collapse"><?= $escaper->escapeHtml(__('Collapse All')) ?></a>
            <span class="separator">|</span>
            <a href="#" id="taxonomy-expand"><?= $escaper->escapeHtml(__('Expand All')) ?></a>
            <span class="separator">|</span>
            <a href="#" id="taxonomy-enable"><?= $escaper->escapeHtml(__('Enable All')) ?></a>
            <span class="separator">|</span>
            <a href="#" id="taxonomy-disable"><?= $escaper->escapeHtml(__('Disable All')) ?></a>
        </div>

        <div class="category_taxonomy_table" id="category_taxonomy_table">
            <?php $categories = $block->getCategories(); ?>
            <?php if (count($categories)): ?>
                <?php foreach ($categories as $category): ?>
                <div class="category_row level<?=
                    (int) $category['level']
                ?> active <?= ($category['store_active'] == 0) ? 'disabled' : ''  ?>"
                     data-category-path="<?= $escaper->escapeHtml($block->formatCategoryPath($category['path'])) ?>"
                     data-parent-category-path="<?=
                            $escaper->escapeHtml($block->formatParentCategoryPath($category['path']))
                        ?>"
                     data-category-id="<?= (int) $category['id'] ?>"
                     style="margin-left: <?= /* @noEscape */ $category['level']*20 ?>px; padding-bottom: 7px;">
                    <?php if ($category['children']): ?>
                        <p class="toggle-expand">
                            <img src="<?=
                                $escaper->escapeUrl($block->getViewFileUrl('MageOS_ShoppingFeed::images/tree-icon.png'))
                            ?>" alt="" class="row-expand">
                        </p>
                    <?php endif; ?>
                    <p class="category-name">
                        <strong><?= $escaper->escapeHtml($category['name']) ?> (#<?= (int) $category['id'] ?>)</strong>
                    </p>
                    <div class="category-disabled">
                        <input type="checkbox" <?= $category['enabled'] ? 'checked="checked"' : ''; ?>
                               class="disabled" id="category_taxonomy_row_<?= (int) $category['id'] ?>_disabled"
                               data-element="d" />
                    </div>
                    <div class="hidden">
                        <input type="number" <?= /* @noEscape */ ($category['store_active'] == 0)
                            ? 'disabled="disabled" title="'
                                . $escaper->escapeHtmlAttr($inactiveTitle) . '"'
                            : ''; ?>
                                       value="<?= (int) $category['priority'] ?>"
                                       class="priority validate-not-negative-number" min="0" step="1"
                                       id="category_taxonomy_row_<?= (int) $category['id'] ?>_priority"
                                       data-element="p" />
                        <input type="text"
                               class="taxonomy <?php /* required-entry */ ?> category-taxonomy-suggest"
                               style="width: 100%;" data-element="tx"
                                    <?= /* @noEscape */ ($category['store_active'] == 0)
                                        ? 'disabled="disabled" title="'
                                            . $escaper->escapeHtmlAttr($inactiveTitle) . '"'
                                        : ''; ?>
                                       value="<?=
                                            $escaper->escapeQuote($escaper->escapeHtml($category['taxonomy']));
                                        ?>" placeholder="<?= $escaper->escapeHtmlAttr($taxonomyPlaceholder) ?>"/>
                        <input type="text" class="prod_type" data-element="ty"
                                        <?= /* @noEscape */ ($category['store_active'] == 0)
                                            ? 'disabled="disabled" title="'
                                                . $escaper->escapeHtmlAttr($inactiveTitle) . '"'
                                            : ''; ?>
                                           value="<?=
                                                $escaper->escapeQuote($escaper->escapeHtml($category['type']));
                                            ?>">
                    </div>
                </div>
                <script>
                    taxonomy[<?= (int) $category['id']; ?>] = {
                        id: <?= (int) $category['id']; ?>,
                        tx: '',
                        ty: '',
                        d: '<?= (int) $category['enabled'] ?>',
                        p: ''
                    };
                </script>
            <?php endforeach; ?>
            <?php else: ?>
                <div class="note">
                    <span><?= $escaper->escapeHtml(__('Save feed to set up category taxonomy.')) ?></span>
                </div>
            <?php endif; ?>

            <input id="taxonomy_aggregated_values" name="config[categories_provider_taxonomy_by_category]"
                   type="hidden" value="" />

            <script>
<?php // phpcs:ignore Generic.Files.LineLength.TooLong -- legacy RequireJS dependency list ?>
                require(['jquery', 'jquery/ui', "mage/mage", "mage/translate","loadingPopup","mageosShoppingFeedCategoryTaxonomy", "mageosShoppingFeedForm"], function($){

                    $(document).ready(function() {
                        $("#category_taxonomy_table").shoppingFeedCategoryTaxonomy();
                        $('#edit_form').shoppingFeedForm();
                    });
                });
            </script>
            <?php if ($block->getElement()->getNote() && strlen($block->getElement()->getNote())): ?>
                <div class="note">
                    <span><?= $escaper->escapeHtml($block->getElement()->getNote()) ?></span>
                </div>
            <?php endif; ?>
        </div>
    </div>

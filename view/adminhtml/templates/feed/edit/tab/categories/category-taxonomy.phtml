    require(['jquery', 'jquery/ui', "mage/mage", "mage/translate","loadingPopup","mageosShoppingFeedCategoryTaxonomy", "mageosShoppingFeedForm"], function($){

        $(document).ready(function() {
            $("#category_taxonomy_table").shoppingFeedCategoryTaxonomy();
            $('#edit_form').shoppingFeedForm();
            <?php if ($block->isTaxonomyAutocompleteEnabled()): ?>
            $('.category-taxonomy-suggest')

         $this->helper(\Magento\Framework\Json\Helper\Data::class)->jsonEncode(
             $element->hasEntityAttribute() ? $element->getEntityAttribute()->getApplyTo() : []
         )
     )?>">
    <?php if (false === $block->getMapExistingColumns()): ?>
        <table class="columns-info-table data-table">
            <thead>
            <th><strong><?= $escaper->escapeHtml(__('Columns')) ?></strong></th>
            <th><?= $escaper->escapeHtml(__('Info about column')) ?></th>
            </thead>
            <tbody>
            <tr>
                <td><strong><?= $escaper->escapeHtml(__('Order')) ?></strong></td>
                <td><?=
                    $escaper->escapeHtml(
                        __('allows you to define the columns order in the feed. Higher numbers go last.')
                    ) ?></td>
            </tr>
            <tr>
                <td><strong><?= $escaper->escapeHtml(__('Feed Column')) ?></strong></td>
                <td><?= $escaper->escapeHtml(__('is the name of the column.')) ?></td>
            </tr>
            <tr>
                <td><strong><?= $escaper->escapeHtml(__('Map To')) ?></strong></td>
<?php // phpcs:ignore Generic.Files.LineLength.TooLong -- translatable phrase ?>
                <td><?= $escaper->escapeHtml(__('can be either Directive (first options in the dropdown), or a product Attribute. Directives have special logic, and Attributes simply grab the value from product.')) ?></td>
            </tr>
            <tr>
                <td><strong><?= $escaper->escapeHtml(__('Options')) ?></strong></td>
                <td><?=
                    $escaper->escapeHtml(
                        __('some Directives accept parameters that can be specified here.')
                    ) ?></td>
            </tr>
            </tbody>
        </table>
    <?php endif; ?>
    <div class="label-w-space">
        <label class="label"><span><?= $escaper->escapeHtml($block->getElement()->getLabel()) ?></span></label>
    </div>
    <div class="control">
        <table class="admin__control-table <?= $escaper->escapeHtml($block->getControlName()); ?>_table data-grid"
               id="<?= $escaper->escapeHtml($block->getControlName()) ?>_table">
            <thead>
                <tr>
                    <th class="data-grid-th col-order required"><?= $escaper->escapeHtml(__('Order')) ?></th>
                    <th class="data-grid-th col-column required"><?= $escaper->escapeHtml(__('Column')) ?></th>
                    <th class="data-grid-th col-attribute required"><?= $escaper->escapeHtml(__('Map to')) ?></th>
                    <th class="data-grid-th col-param"><?= $escaper->escapeHtml(__('Options')) ?></th>
                    <th class="data-grid-th col-delete"><?=  $escaper->escapeHtml(__('Action')) ?></th>
                </tr>
            </thead>
            <tbody id="<?= $escaper->escapeHtml($htmlId) ?>_container"></tbody>
            <tfoot>
                <tr>
                    <td colspan="5" class="col-actions-add"><?= /* @noEscape */ $block->getAddButtonHtml() ?></td>
                </tr>
            </tfoot>
        </table>

<script>
require([
    'mage/template',
    "prototype",
    "mage/adminhtml/form"
], function (mageTemplate) {

//<![CDATA[
var rowTemplate = '<tr>'
    + '<td class="col-order">'
<?php // phpcs:ignore Generic.Files.LineLength.TooLong -- legacy JS row template markup ?>
    + '<input class="<?= $escaper->escapeHtml($htmlClass) ?> order required-entry validate-greater-than-zero" type="text" name="<?= $escaper->escapeHtml($htmlName) ?>[<%- data.index %>][order]" value="<%- data.order %>" id="<?= $escaper->escapeHtml($block->getControlName()) ?>_row_<%- data.index %>_order" />'
    + '</td>'
    + '<td class="col-column">'
    <?php if ($block->getMapExistingColumns()): ?>
<?php // phpcs:ignore Generic.Files.LineLength.TooLong -- legacy JS row template markup ?>
    + '<select class="<?= $escaper->escapeHtml($htmlClass) ?> required-entry" name="<?= $escaper->escapeHtml($htmlName) ?>[<%- data.index %>][column]" id="<?= $escaper->escapeHtml($block->getControlName()); ?>_row_<%- data.index %>_column">'
        <?php foreach ($block->getColumns() as $column): ?>
    + '<option value="<?= $escaper->escapeHtml($column['value']) ?>"><?=
        $escaper->escapeJsQuote($escaper->escapeHtml($column['label']))
    ?></option>'
    <?php endforeach ?>
    + '</select>'
    <?php else: ?>
<?php // phpcs:ignore Generic.Files.LineLength.TooLong -- legacy JS row template markup ?>
    + '<input type="text" name="<?= $escaper->escapeHtml($htmlName) ?>[<%- data.index %>][column]" value="<%- data.column %>" id="<?= $escaper->escapeHtml($block->getControlName()) ?>_row_<%- data.index %>_column" />'
    <?php endif; ?>
    + '</td>'
<?php // phpcs:ignore Generic.Files.LineLength.TooLong -- legacy JS row template markup ?>
    + '<td class="col-attribute"><select class="<?= $escaper->escapeHtml($htmlClass) ?> attribute required-entry" name="<?= $escaper->escapeHtml($htmlName) ?>[<%- data.index %>][attribute]" id="<?= $escaper->escapeHtml($block->getControlName()) ?>_row_<%- data.index %>_attribute">'
    <?php foreach ($block->getDirectivesAndAttributes() as $group): ?>
    + '<optgroup label="<?= $escaper->escapeHtml($group['label']) ?>">'
        <?php foreach ($group['value'] as $attribute): ?>
    + '<option value="<?= $escaper->escapeHtml($attribute['value']) ?>"><?=
        $escaper->escapeJsQuote($escaper->escapeHtml($attribute['label']))
    ?></option>'
        <?php endforeach ?>
    + '</optgroup>'
    <?php endforeach ?>
    + '</select></td>'
    + '<td class="col-param" id="<?= $escaper->escapeHtml($block->getControlName()) ?>_row_<%- data.index %>_param">'
    + '<input type="hidden" name="<?= $escaper->escapeHtml($htmlName) ?>[<%- data.index %>][param]" value="" />'
    + '</td>'
<?php // phpcs:ignore Generic.Files.LineLength.TooLong -- legacy JS row template markup ?>
    + '<td class="col-delete"><input type="hidden" name="<?= $escaper->escapeHtml($htmlName) ?>[<%- data.index %>][delete]" class="delete" value="" id="<?= $escaper->escapeHtml($block->getControlName()) ?>_row_<%- data.index %>_delete" />'
<?php // phpcs:ignore Generic.Files.LineLength.TooLong -- legacy JS row template markup ?>
    + '<button title="<?= $escaper->escapeHtml(__('Delete')); ?>" type="button" class="action- scalable delete icon-btn delete-product-option" id="<?= $escaper->escapeHtml($block->getControlName()) ?>_row_<%- data.index %>_delete_button" onclick="return <?= $escaper->escapeHtml($block->getControlName()) ?>.deleteItem(event);">'
    + '<span><?= $escaper->escapeHtml(__("Delete")) ?></span></button></td>'
    + '</tr>';

var <?= $escaper->escapeHtml($block->getControlName()) ?> = {
    config: <?= /* @noEscape */ $block->configToJson();?>,
    htmlName: '<?= $escaper->escapeHtml($htmlName) ?>',
    template: mageTemplate(rowTemplate),
    itemsCount: 0,
    addItem : function () {
        <?php if ($readonly): ?>
        if (arguments.length < 5) {
            return;
        }
        <?php endif; ?>
        var data = {
            order: this.nextOrder(),
            column: '<?= $block->getMapExistingColumns() ? $escaper->escapeHtml($block->getDefaultColumn()) : ''; ?>',
            attribute: '<?= $escaper->escapeHtml($block->getDefaultAttribute()) ?>',
            param: '',
            readOnly: false,
            index: this.itemsCount++,
        };

        if(arguments.length == 5) {
            data.order     = arguments[0];
            data.column    = arguments[1];
            data.attribute = arguments[2];
            data.param     = arguments[3];
            data.readOnly  = arguments[4];
        }

        Element.insert($('<?= $escaper->escapeHtml($htmlId) ?>_container'), {
            bottom : this.template({
                data: data
            })
        });

        $('<?=
            $escaper->escapeHtml($block->getControlName());
        ?>_row_' + data.index + '_attribute').value = data.attribute;
        $('<?=
            $escaper->escapeHtml($block->getControlName());
        ?>_row_' + data.index + '_column').value    = data.column;

        if (data.readOnly == '1') {
            ['order','column', 'attribute', 'param', 'delete'].each(function(idx){
                $('<?= $escaper->escapeHtml($block->getControlName()) ?>_row_'+data.index+'_'+idx).disabled = true;
            });
            $('<?= $escaper->escapeHtml($block->getControlName()) ?>_row_'+data.index+'_delete_button').hide();
        }

        <?php if ($readonly): ?>
        $('<?= $escaper->escapeHtml($htmlId) ?>_container').select('input', 'select').each(this.disableElement);
        $('<?= $escaper->escapeHtml($htmlId) ?>_container').up('table').select('button').each(this.disableElement);
        <?php else: ?>
<?php // phpcs:ignore Generic.Files.LineLength.TooLong -- legacy JS row template markup ?>
        $('<?= $escaper->escapeHtml($htmlId) ?>_container').select('input', 'select').each(function(el){ Event.observe(el, 'change', el.setHasChanges.bind(el)); });
        <?php endif; ?>

        var el = $('<?= $escaper->escapeHtml($block->getControlName()) ?>_row_' + data.index + '_attribute');
        Event.observe(el, 'change', this.eventListenerRowChanges.bindAsEventListener(this, data));
        this.fillParamsColumn(data.attribute, data);
    },
    disableElement: function(el) {
        el.disabled = true;
        el.addClassName('disabled');
    },
    deleteItem: function(event) {
        var tr = Event.findElement(event, 'tr');
        if (tr) {
            Element.select(tr, '.delete').each(function(elem){elem.value='1'});
            Element.select(tr, ['input', 'select']).each(function(elem){elem.hide()});
            Element.hide(tr);
            Element.addClassName(tr, 'no-display template');
        }
        return false;
    },
    nextOrder : function () {
        var v, max = 0;
        $('<?= $escaper->escapeHtml($htmlId) ?>_container').up('table').select('input.order').each(function (elm) {
            v = parseInt(elm.value)
            if (v > max) {
                max = v;
            }
        });
        return max + 10;
    },
    eventListenerRowChanges : function (event, data) {
        data.param = '';
        this.fillParamsColumn(event.element().value, data);
    },
    fillParamsColumn : function (directive, data) {
        var paramColumn = $('<?= $escaper->escapeHtml($block->getControlName()) ?>_row_'+data.index+'_param');

        if (this.config.directives[directive] == undefined) {
            paramColumn.innerHTML = '';
            return;
        }

        if (data.param == '') {
            data.param = this.config.directives[directive]['param'];
        }

        template = this.config.directives[directive]['template'];

        data.htmlName = this.htmlName;
        html = new Template(template);

        paramColumn.innerHTML = html.evaluate(data);

        this.preselectParamsColumn(data);
    },
    preselectParamsColumn : function (data) {
        var paramColumn = $('<?= $escaper->escapeHtml($block->getControlName()) ?>_row_'+data.index+'_param');
        var select = paramColumn.select('select[multiple]')[0];
        // Keep saved attribute codes when the attribute is absent from this catalog.
        // Otherwise the browser omits the parameter and a later save can change its meaning.
        if (select && data.param instanceof Array) {
            data.param.forEach(function (value) {
                var exists = Array.prototype.some.call(select.options, function (option) {
                    return option.value === String(value);
                });
                if (!exists && value !== '') {
                    select.add(new Option(String(value), String(value)));
                }
            });
        }
        var options = paramColumn.select('select option');
        if (options instanceof Array && options.length) {
            if (data.param instanceof Array && data.param.length) {
                for (var key = 0; key < data.param.length; ++key) {
                    for (var index = 0; index < options.length; ++index) {
                        if (options[index].value == data.param[key]) {
                            options[index].selected = true;
                        }
                    }
                }
            } else {
                for (var index = 0; index < options.length; ++index) {
                    if (options[index].value == data.param) {
                        options[index].selected = true;
                    }
                }
            }
        }
    }
};
    var param = '';
<?php foreach ($block->getValues() as $item): ?>
    <?php if (isset($item['param']) && is_array($item['param'])): ?>
    param = <?= /* @noEscape */
        json_encode($item['param'], JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_THROW_ON_ERROR);
    ?>;
    <?php else: ?>
<?php // phpcs:ignore Magento2.Functions.DiscouragedFunction -- legacy JS string escaping; output must stay identical ?>
    param = '<?= $escaper->escapeJs(isset($item['param']) ? addslashes($escaper->escapeHtml($item['param'])) : '') ?>';
    <?php endif; ?>
    <?= $escaper->escapeHtml($block->getControlName()) ?>.addItem(
        '<?= (int) $item['order'] ?>',
        '<?= $escaper->escapeJsQuote($escaper->escapeHtml($item['column'])) ?>',
        '<?= $escaper->escapeJsQuote($escaper->escapeHtml($item['attribute'])) ?>',
        param,
        <?= (int) !empty($item['readonly'])?>
    );
<?php endforeach; ?>
<?php if ($readonly): ?>
$('<?= $escaper->escapeHtml($htmlId) ?>_container').up('table').select('button')
    .each(<?= $escaper->escapeHtml($block->getControlName()) ?>.disableElement);
<?php endif; ?>

window.<?= $escaper->escapeHtml($block->getControlName()) ?> = <?= $escaper->escapeHtml($block->getControlName()) ?>;
//]]>

});
</script>
        <?php if ($block->getElement()->getNote() && strlen($block->getElement()->getNote())): ?>
        <div class="note">
            <span><?=
                $escaper->escapeHtml($block->getElement()->getNote(), ['a', 'strong', 'b', 'em', 'br', 'span'])
            ?></span>
        </div>
        <?php endif; ?>
    </div>
</div>

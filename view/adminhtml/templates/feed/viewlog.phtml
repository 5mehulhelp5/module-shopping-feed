<?php /** @var $block MageOS\ShoppingFeed\Block\Adminhtml\Feed\Viewlog */?>
<?php if ($block->getError()): ?>
    <span><?= $escaper->escapeHtml($block->getError()) ?></span>
<?php else: ?>
    <ul>
        <?php foreach ($block->getFileLines() as $line):?>
            <li><?= $escaper->escapeHtml($line) ?></li>
        <?php endforeach; ?>
    </ul>
<?php endif; ?>

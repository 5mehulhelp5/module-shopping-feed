<?xml version="1.0"?>
<ruleset name="MageOS_ShoppingFeed">
    <description>Mage-OS Shopping Feed coding-standard release gate. Warnings fail the run.</description>

    <arg name="basepath" value="."/>
    <arg name="extensions" value="php,phtml"/>
    <arg name="parallel" value="8"/>

    <rule ref="Magento2"/>

    <!--
        The retained legacy editor templates (no layout renders them since the 1.2.0 UI component
        editor) encode their data-apply-to attributes through the template engine's
        $this->helper(Json\Helper\Data). A block has no helper() method, so replacing $this would
        break any extension that still renders them. Exclude only that sniff, only there.
    -->
    <rule ref="Magento2.Templates.ThisInTemplate">
        <exclude-pattern>view/adminhtml/templates/feed/edit/tab/*</exclude-pattern>
    </rule>

    <file>Block</file>
    <file>Console</file>
    <file>Controller</file>
    <file>Cron</file>
    <file>Model</file>
    <file>Observer</file>
    <file>Plugin</file>
    <file>Test</file>
    <file>Ui</file>
    <file>view</file>
    <file>registration.php</file>
</ruleset>
